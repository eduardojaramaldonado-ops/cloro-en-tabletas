# =========================================================
# cloroentabletas.cl — reglas Apache (SEO + rendimiento)
# Si el servidor ya tiene un .htaccess, combina estas reglas
# con las existentes en vez de reemplazarlo.
# =========================================================

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Dominio canónico: https y sin www (una sola redirección 301)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://cloroentabletas.cl%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://cloroentabletas.cl%{REQUEST_URI} [L,R=301]

# 2. /index.html duplicado -> URL de carpeta
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]

# 3. Restos del repositorio que no son parte del sitio: responder 404
#    (el despliegue no borra archivos viejos de public_html)
RewriteRule ^(src|public)(/.*)?$ - [R=404,L]
RewriteRule ^(package(-lock)?\.json|vite\.config\.js|eslint\.config\.js|git|README\.md|netlify\.toml|\.gitignore)$ - [R=404,L]

# 4. URLs del sitio anterior (WordPress/WooCommerce) -> páginas actuales
RewriteRule ^blog/como-limpiar-una-piscina-verde/?$ https://cloroentabletas.cl/blog/piscina-verde-como-recuperarla/ [R=301,L,QSD]
RewriteRule ^blog/mantener-la-piscina/?$ https://cloroentabletas.cl/blog/como-mantener-piscina-cristalina/ [R=301,L,QSD]
RewriteRule ^mantencion-de-piscinas/?$ https://cloroentabletas.cl/blog/como-mantener-piscina-cristalina/ [R=301,L,QSD]
RewriteRule ^tienda/?$ https://cloroentabletas.cl/productos/ [R=301,L,QSD]
RewriteRule ^producto/baja-ph[^/]*/?$ https://cloroentabletas.cl/productos/baja-ph-piscina-1-kilo/ [R=301,L,QSD]
RewriteRule ^producto/cloro-en-tabletas-pack-de-4-kilos/?$ https://cloroentabletas.cl/productos/cloro-en-tabletas-4-kilos/ [R=301,L,QSD]
RewriteRule ^producto/ https://cloroentabletas.cl/productos/ [R=301,L,QSD]
</IfModule>

# 3. Página 404 propia
ErrorDocument 404 /404.html

# 4. Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# 5. Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>

# 6. Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. No servir archivos internos del proyecto
<FilesMatch "^(netlify\.toml|\.gitignore|README\.md)$">
  Require all denied
</FilesMatch>
